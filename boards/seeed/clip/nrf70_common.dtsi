iovdd-ctrl-gpios = <&gpio0 26 GPIO_ACTIVE_HIGH>;
bucken-gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
host-irq-gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
/* IOVDD takes ~10ms to ramp up after IO EN assertion on this board */
iovdd-power-up-delay-ms = <20>;


wifi-max-tx-pwr-2g-dsss = <21>;
wifi-max-tx-pwr-2g-mcs0 = <16>;
wifi-max-tx-pwr-2g-mcs7 = <16>;

wlan0: wlan {
	compatible = "nordic,wlan";
};
