/* Disable power regulators not needed for radio test */

/ {
	mic_reg {
		status = "disabled";
	};
	oled_reg {
		status = "disabled";
	};
};

/* Disable unused peripherals */

&i2c1 {
	status = "disabled";
};

&i2c2 {
	status = "disabled";
};

&pdm0 {
	status = "disabled";
};

&spi3 {
	status = "disabled";
};

&spi4 {
	status = "disabled";
};

&adc {
	status = "disabled";
};

&usbd {
	status = "disabled";
};
