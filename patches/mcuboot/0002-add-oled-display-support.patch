+/* ---- Bitmap rendering ---- */
+
+static void draw_bitmap(int x, int y, const uint8_t *bmp, int w, int h)
+{
+	int bytes_per_col = (h + 7) / 8;
+	for (int col = 0; col < w; col++) {
+		for (int row = 0; row < h; row++) {
+			int byte_idx = col * bytes_per_col + (row / 8);
+			int bit_idx = 7 - (row % 8);
+			if (bmp[byte_idx] & (1 << bit_idx)) {
+				set_pixel(x + col, y + row);
+			}
+		}
+	}
+}
