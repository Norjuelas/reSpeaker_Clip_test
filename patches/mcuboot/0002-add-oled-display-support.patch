+ * OLED display helpers for MCUboot status messages.
+ * Uses Zephyr Display API to render text on CH1115 OLED.
+ *
+ * Copyright (c) 2025 Seeed Technology Co., Ltd.
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <zephyr/kernel.h>
+#include <zephyr/device.h>
+#include <zephyr/drivers/display.h>
+#include <zephyr/drivers/gpio.h>
+#include <zephyr/devicetree.h>
+#include <stdio.h>
+#include <string.h>
+#include "bootutil/bootutil_log.h"
+#ifdef CONFIG_MCUBOOT_DISPLAY
+#include "bootutil/mcuboot_status.h"
+#endif
+
+BOOT_LOG_MODULE_DECLARE(mcuboot);
+
+/* OLED dimensions */
+#define OLED_WIDTH   88
+#define OLED_HEIGHT  48
+#define OLED_BUF_SIZE (OLED_WIDTH * OLED_HEIGHT / 8)
+
+/* Font dimensions */
+#define FONT_WIDTH  6
+#define FONT_HEIGHT 12
+
+/* Zephyr display device */
+static const struct device *display_dev;
+
+/* OLED power enable: P1.8 (from oled_reg regulator) */
+#if DT_NODE_EXISTS(DT_NODELABEL(oled_reg))
+static const struct gpio_dt_spec oled_pwr =
+	GPIO_DT_SPEC_GET(DT_NODELABEL(oled_reg), enable_gpios);
+#endif
+
+/* Display buffer */
+static uint8_t display_buf[OLED_BUF_SIZE];
+
+/* Initialization state */
+static bool display_initialized;
+
+/* ---- Pixel operations ---- */
+
+static inline void set_pixel(int x, int y)
+{
+	if (x < 0 || x >= OLED_WIDTH || y < 0 || y >= OLED_HEIGHT) {
+		return;
+	}
+	display_buf[(y / 8) * OLED_WIDTH + x] |= (1 << (y % 8));
+}
