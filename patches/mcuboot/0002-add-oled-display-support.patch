+/* ---- Text rendering ---- */
+
+static void draw_char(char c, int x, int y)
+{
+	if (c < 32 || c > 126) {
+		return;
+	}
+	const uint8_t *glyph = font_6x12[c - 32];
+	for (int row = 0; row < FONT_HEIGHT; row++) {
+		uint8_t row_data = glyph[row];
+		for (int col = 0; col < FONT_WIDTH; col++) {
+			if (row_data & (0x80 >> col)) {
+				set_pixel(x + col, y + row);
+			}
+		}
+	}
+}
+
+static void draw_string(const char *str, int x, int y)
+{
+	int cur_x = x;
+	while (*str && cur_x < OLED_WIDTH) {
+		draw_char(*str, cur_x, y);
+		cur_x += FONT_WIDTH;
+		str++;
+	}
+}
+
+static int string_width(const char *str)
+{
+	int w = 0;
+	while (*str) {
+		w += FONT_WIDTH;
+		str++;
+	}
+	return w;
+}
+
+/* ---- Display flush ---- */
+
+static int flush_display(void)
+{
+	struct display_buffer_descriptor desc = {
+		.buf_size = OLED_BUF_SIZE,
+		.width = OLED_WIDTH,
+		.height = OLED_HEIGHT,
+		.pitch = OLED_WIDTH,
+	};
+
+	return display_write(display_dev, 0, 0, &desc, display_buf);
+}
+
+/* ---- Public API ---- */
+
+void io_display_init(void)
+{
+	if (display_initialized) {
+		return;
+	}
+
+	display_dev = DEVICE_DT_GET(DT_CHOSEN(zephyr_display));
+	if (!device_is_ready(display_dev)) {
+		BOOT_LOG_ERR("Display device not ready");
+		return;
+	}
+
+	/* Ensure OLED is on (may already be powered by regulator-boot-on) */
+	display_blanking_off(display_dev);
+
+	/* Set brightness to match app default */
+	display_set_brightness(display_dev, 32);
+
+	/* Clear display */
+	memset(display_buf, 0, OLED_BUF_SIZE);
+	flush_display();
+
+	display_initialized = true;
+	BOOT_LOG_INF("OLED display initialized");
+}
+
+void io_display_show(const char *line1, const char *line2)
+{
+	if (!display_initialized) {
+		return;
+	}
+
+	memset(display_buf, 0, OLED_BUF_SIZE);
+
+	/* Two lines centered vertically: total height = 12 + 4 + 12 = 28 */
+	int y1 = (OLED_HEIGHT - 28) / 2;
+	int y2 = y1 + FONT_HEIGHT + 4;
+
+	if (line1) {
+		int w = string_width(line1);
+		int x = (OLED_WIDTH - w) / 2;
+		if (x < 0) x = 0;
+		draw_string(line1, x, y1);
+	}
+
+	if (line2) {
+		int w = string_width(line2);
+		int x = (OLED_WIDTH - w) / 2;
+		if (x < 0) x = 0;
+		draw_string(line2, x, y2);
+	}
+
+	flush_display();
+}
+
+void io_display_show_progress(const char *label, int percent)
+{
+	if (!display_initialized) {
+		return;
+	}
+
+	memset(display_buf, 0, OLED_BUF_SIZE);
+
+	/* OTA icon at top-left */
+	draw_bitmap(0, 0, icon_ota, ICON_W, ICON_H);
+
+	/* Label text to the right of icon */
+	if (label) {
+		draw_string(label, 22, 6);
+	}
+
+	/* Progress bar at y=26, h=2 */
+	int bar_x = 10, bar_y = 26, bar_w = 68, bar_h = 2;
+	for (int x = bar_x; x < bar_x + bar_w; x++) {
+		set_pixel(x, bar_y);
+		set_pixel(x, bar_y + bar_h);
+	}
+	for (int y = bar_y; y <= bar_y + bar_h; y++) {
+		set_pixel(bar_x, y);
+		set_pixel(bar_x + bar_w - 1, y);
+	}
+	int fill_w = (percent * (bar_w - 2)) / 100;
+	for (int x = bar_x + 1; x < bar_x + 1 + fill_w; x++) {
+		for (int y = bar_y + 1; y < bar_y + bar_h; y++) {
+			set_pixel(x, y);
+		}
+	}
+
+	/* Percentage text: number + "%" centered at y=38 */
+	char pct[8];
+	snprintf(pct, sizeof(pct), "%u", (unsigned)percent);
+	int num_len = string_width(pct);
+	int total_w = num_len + 3 + FONT_WIDTH;
+	int pct_x = (OLED_WIDTH - total_w) / 2;
+	draw_string(pct, pct_x, 38);
+	draw_string("%", pct_x + num_len + 3, 38);
+
+	flush_display();
+}
+
+void io_display_off(void)
+{
+	if (!display_initialized) {
+		return;
+	}
+
+	display_blanking_on(display_dev);
+
+#if DT_NODE_EXISTS(DT_NODELABEL(oled_reg))
+	if (oled_pwr.port) {
+		gpio_pin_set_dt(&oled_pwr, 0);
+	}
+#endif
+
+	display_initialized = false;
+}
+
+/* Scale 6x12 glyph to 8x16, preserving 1:2 aspect ratio */
+static void draw_char_8x16(char c, int x, int y)
+{
+	if (c < 32 || c > 126) {
+		return;
+	}
+	const uint8_t *glyph = font_8x16[c - 32];
+	for (int row = 0; row < FONT8x16_HEIGHT; row++) {
+		uint8_t row_data = glyph[row];
+		for (int col = 0; col < FONT8x16_WIDTH; col++) {
+			if (row_data & (0x80 >> col)) {
+				set_pixel(x + col, y + row);
+			}
+		}
+	}
+}
+
+/* Motor GPIO: P1.06 controls PMIC BUCK1 (MOTOR_3V3) */
+#define MOTOR_NODE DT_NODELABEL(gpio1)
+#define MOTOR_PIN  6
+
+static void motor_on(void)
+{
+	const struct device *gpio1 = DEVICE_DT_GET(MOTOR_NODE);
+	if (device_is_ready(gpio1)) {
+		gpio_pin_set_raw(gpio1, MOTOR_PIN, 1);
+	}
+}
+
+static void motor_off(void)
+{
+	const struct device *gpio1 = DEVICE_DT_GET(MOTOR_NODE);
+	if (device_is_ready(gpio1)) {
+		gpio_pin_set_raw(gpio1, MOTOR_PIN, 0);
+	}
+}
+
+void io_display_boot_animation(void)
+{
+	if (!display_initialized) {
+		return;
+	}
+
+	/* Configure motor GPIO */
+	const struct device *gpio1 = DEVICE_DT_GET(MOTOR_NODE);
+	if (device_is_ready(gpio1)) {
+		gpio_pin_configure(gpio1, MOTOR_PIN, GPIO_OUTPUT_LOW);
+	}
+
+	const char *text = "seeed studio";
+	int num_chars = strlen(text);
+	int char_adv = 7;
+	int char_h = 16;
+	int text_w = num_chars * char_adv;
+	int text_x = (OLED_WIDTH - text_w) / 2;
+	int text_y = (OLED_HEIGHT - char_h) / 2;
+	int center_x = OLED_WIDTH / 2;
+	int center_idx = num_chars / 2;
+	int steps = center_idx;
+
+	for (int step = 0; step <= steps; step++) {
+		memset(display_buf, 0, OLED_BUF_SIZE);
+
+		/* Shrinking vertical line */
+		int line_h = 8 * (steps - step) / steps;
+		if (line_h > 0) {
+			int line_top = (OLED_HEIGHT - line_h) / 2;
+			for (int y = line_top; y < line_top + line_h; y++) {
+				set_pixel(center_x - 1, y);
+				set_pixel(center_x, y);
+			}
+		}
+
+		/* Reveal characters from center outward */
+		for (int i = 0; i < step; i++) {
+			int li = center_idx - 1 - i;
+			int ri = center_idx + i;
+			if (li >= 0) {
+				draw_char_8x16(text[li],
+					       text_x + li * char_adv,
+					       text_y);
+			}
+			if (ri < num_chars) {
+				draw_char_8x16(text[ri],
+					       text_x + ri * char_adv,
+					       text_y);
+			}
+		}
+
+		flush_display();
+
+		if (step == 3) {
+			motor_on();
+		} else if (step == 4) {
+			motor_off();
+		} else if (step == 5) {
+			motor_on();
+		}
+
+		k_msleep(step == 0 ? 300 : 60);
+	}
+
+	motor_off();
+
+	k_msleep(500);
+}
