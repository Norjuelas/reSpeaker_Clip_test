+
+__weak void mcuboot_status_change(mcuboot_status_type_t status)
+{
+#ifdef CONFIG_MCUBOOT_DISPLAY
+	if (status == MCUBOOT_STATUS_UPGRADING) {
+		io_display_show_progress("Updating...", 0);
+	}
+#endif
+}
+
+#ifdef CONFIG_MCUBOOT_DISPLAY
+void boot_serial_upload_progress_hook(uint32_t img_index,
+                                      size_t curr_off, size_t img_size)
+{
+	if (img_size > 0) {
+		int percent = (int)((curr_off * 100) / img_size);
+		if (percent > 100) {
+			percent = 100;
+		}
+		io_display_show_progress("Updating...", percent);
+	}
+}
+
+void boot_copy_progress_hook(uint32_t total, uint32_t copied)
+{
+	if (total > 0) {
+		/* Cap at 99% — post-copy operations (magic, security counter) take ~3s */
+		int percent = (int)((copied * 99) / total);
+		if (percent > 99) {
+			percent = 99;
+		}
+		io_display_show_progress("Updating...", percent);
+	}
+}
+#endif
