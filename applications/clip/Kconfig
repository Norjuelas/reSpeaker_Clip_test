# =============================================================================
# Battery / Fuel-Gauge Configuration
# =============================================================================

config CLIP_BATTERY_WIFI_LOAD_COMPENSATION
	bool "Compensate fuel gauge for WiFi (nRF70) current the NPM1300 IBAT cannot see"
	default y
	help
	  The nRF7002 main VDD (BUCKVBAT) is tied to VBAT upstream of the NPM1300,
	  so its radio TX/RX/internal-buck current never flows through the PMIC's
	  IBAT sense resistor. GAUGE_AVG_CURRENT therefore undercounts discharge
	  (and over-counts charge while charging) whenever WiFi is on, so the fuel
	  gauge SoC reads high. Fold a state-keyed WiFi-load estimate into the
	  current fed to nrf_fuel_gauge_process() to cancel the blind spot, in both
	  charge and discharge states. Disable only for an uncompensated baseline.

config CLIP_BATTERY_WIFI_AP_LOAD_MA
	int "Estimated unseen nRF70 current with AP up, no transfer (mA)"
	default 59
	help
	  Estimated nRF7002 current (mA) drawn from VBAT-direct while the WiFi AP
	  is up but no file transfer is active. Added to the discharge side of the
	  fuel-gauge current. Calibrate by measuring total battery current (PPK on
	  the VBAT rail, upstream of the NPM1300) and the NPM1300 IBAT logged at
	  state transitions: unseen = total - |IBAT|. Default is an upper bound
	  (total - WiFi-off baseline); over-compensating is safer than under-.
	  Trim to (total - |IBAT|) once IBAT is measured.

config CLIP_BATTERY_WIFI_TX_LOAD_MA
	int "Estimated unseen nRF70 current during active UDP transfer (mA)"
	default 99
	help
	  Estimated nRF7002 current (mA) drawn from VBAT-direct while a WiFi UDP
	  file transfer is active (AP up + transfer). See CLIP_BATTERY_WIFI_AP_LOAD_MA
	  for the calibration method. Default is an upper bound; trim to (total - |IBAT|).

config CLIP_BATTERY_DISPLAY_MAX_STEP
	int "Max displayed SoC change per poll (%)"
	default 3
	help
	  Rate-limits the DISPLAYED state-of-charge toward the fuel-gauge value,
	  DIRECTIONALLY, polled every 60 s: while charging the display only moves
	  UP toward the gauge (catch up + track the charge); while discharging it
	  only moves DOWN (track depletion). A normal charge/discharge changes by
	  <= MAX_STEP per poll, so the display tracks it with ZERO lag. The gauge's
	  voltage-reconciliation up-correction (the ~5-15% first-reboot jump after
	  charge/discharge cycling) is therefore held while discharging (no upward
	  creep on a discharging battery) and only corrected on the next charge.
	  Set 0 to disable smoothing (display the raw gauge SoC directly). The
	  displayed value is persisted across reboot so it resumes from the value
	  shown before reboot (no cross-reboot lag accumulation).

# =============================================================================
# Debug Configuration
# =============================================================================

config CLIP_DEBUG_STATS
	bool "Enable periodic thread stack and heap usage logging"
	default n
	help
	  Print thread stack usage and heap stats every 10 seconds.

config CLIP_STA_AUTOCONNECT
	bool "Join the stored WiFi network at boot"
	depends on NRF70_STA_MODE
	default y
	help
	  When station credentials are stored (AT+STACFG), try to join that
	  network during startup instead of waiting for AT+STA=on.

	  Keeps WiFi reachable when BLE is unavailable — a broken bond would
	  otherwise make the network unreachable, since AT+STA=on only arrives
	  over BLE. Also lets the device be found with an IP scanner after a
	  plain power-up.

	  Costs power: the radio comes up on every boot. Turn off for
	  battery-sensitive production builds.

config CLIP_NRF70_FW_PATH
	string "Path to the nRF7002 firmware patch on the SD card"
	default "/SD:/nrf70.bin"
	help
	  Where nrf70_fw_provision() looks for the patch that gets written into
	  nrf70_fw_partition.

	  The patch is kept out of the application image to save ~87KB, and the
	  partition is not managed by MCUboot (the deployed bootloader only
	  handles two images), so the application provisions it from this file.
	  Copy build-*/nrf70.bin to the card under this name.

config CLIP_USB_AT_AT_BOOT
	bool "Enable the USB AT channel at boot"
	default n
	help
	  Bring up USB CDC ACM during startup instead of waiting for AT+USB=on.

	  AT+USB=on can only arrive over BLE, so a lost bond locks you out of the
	  device entirely: MCUboot has no BLE, the production snippet has no UART
	  console, and turning on the SD logs itself needs an AT command. With
	  this enabled a plain USB cable is always a way in.

	  Costs idle current (USB stays enumerated) — development builds only.

config CLIP_STA_AUTOCONNECT_DELAY_MS
	int "Delay before the boot-time WiFi join, in milliseconds"
	depends on CLIP_STA_AUTOCONNECT
	default 10000
	help
	  Wait this long after startup before bringing the radio up.

	  Not cosmetic: powering the nRF70 allocates ~60KB of heap, and doing it
	  while the rest of the system is still initialising hung the device mid
	  boot animation. The delay lets startup finish first. Lower it only if
	  you have verified the device still boots reliably.

endif # CLIP

config CLIP_HEALTH_INTERVAL_S
	int "Seconds between health heartbeats"
	depends on NRF70_STA_MODE
	default 300
	range 30 3600
	help
	  How often the device POSTs its state to /health on the configured
	  endpoint. Five minutes is a compromise: often enough that a panel
	  showing 100 devices is not stale, rare enough that the radio is not
	  waking constantly on a 170 mAh cell.

	  Each beat is one short POST, so the cost is the radio wake-up rather
	  than the bytes.

config CLIP_HEALTH_AUTOSTART
	bool "Start the heartbeat at boot"
	depends on NRF70_STA_MODE
	default y
	help
	  Begin beating as soon as there is a network and an endpoint, without
	  waiting for AT+HEALTH=on. A device in the field has nobody to type the
	  command — this is what makes it visible in the panel on its own.

config CLIP_USB_MSC
	bool "Exponer la microSD como unidad USB"
	default y
	help
	  Presenta la tarjeta al ordenador como un disco extraible.

	  Es una exposicion real y conviene no endulzarla: la carcasa es cerrada y
	  la tarjeta no se saca, de modo que MSC es LA via para llevarse todas las
	  grabaciones con solo enchufar un cable.

	  Sigue encendido porque apagarlo ahora deja ciego sin proteger. Con la
	  carcasa cerrada, MSC es el unico acceso fisico a la tarjeta: sin el, el
	  log de /SD:/LOG no se puede leer nunca mas, nrf70.bin no se puede
	  provisionar, y no queda rescate si la red no levanta.

	  El orden es cifrar primero, cerrar despues. Con el audio cifrado en
	  reposo, montar la tarjeta deja de dar nada util.

	  El precio de tenerlo encendido, mientras tanto: no se puede grabar
	  mientras USB esta activo, y como el canal AT enciende USB al arrancar,
	  el boton queda muerto diez minutos tras cada reinicio con un "USB Busy"
	  en pantalla.

config CLIP_UPLOAD_TLS
	bool "Subir el audio por TLS"
	depends on NRF70_STA_MODE
	default n
	help
	  Cifra la subida de audio y el latido de salud.

	  Apagado por defecto porque no cabe con Bluetooth: TLS recortado mide
	  ~38KB y la imagen con BLE no tiene ese hueco. Se enciende junto con
	  overlay-tls.conf, que quita BLE y recorta mbedTLS al minimo.

	  La CA se lee de /SD:/ca.pem al primer envio, no se compila dentro: asi
	  una misma imagen vale para toda la flota. Sin ese fichero el device
	  cifra igual pero no verifica con quien habla — protege de quien escucha
	  la red, no de quien se hace pasar por el servicio.
