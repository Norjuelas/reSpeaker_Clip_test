config CLIP_STORAGE_FULL_PERCENT
	int "SD usage percent at which recording is refused (storage full)"
	default 95
	range 50 99
	help
	  Recording is refused and a "Storage Full" error is shown when SD card
	  usage reaches this percentage (e.g. 95 = refuse at 95% full).

config CLIP_LOG_FS_DEFAULT_ON
	bool "Enable FS (SD card) log backend by default at boot"
	default y if LOG_BACKEND_UART
	help
	  FS log default follows the UART log backend: debug builds (which keep
	  UART logging) default FS log on (INF to /SD:/LOG); the production
	  snippet disables UART logging, so FS log defaults off there. The FS
	  log can still be toggled at runtime with AT+LOG=off|info|debug.
	  Coupling to LOG_BACKEND_UART (rather than overriding this symbol from
	  the production snippet) avoids broadcasting an app-only Kconfig symbol
	  into the mcuboot sysbuild image, where it is undefined.

config CLIP_LOG_FS_BOOT_WINDOW_S
	int "Seconds of FS logging after boot before it retires itself (0 = never)"
	default 0 if LOG_BACKEND_UART
	default 120
	help
	  Only meaningful when CLIP_LOG_FS_DEFAULT_ON is set. The FS log backend
	  deactivates itself this many seconds after boot, as if AT+LOG=off had
	  been sent.

	  Why this exists: prj.conf sets CLIP_LOG_FS_DEFAULT_ON=y explicitly, on
	  purpose, so that nRF70 patch provisioning is visible on the card --
	  AT+LOG=debug only takes effect once boot is over, so without the boot
	  default that outcome could not be seen at all. But an explicit
	  assignment in prj.conf beats the 'default y if LOG_BACKEND_UART' above,
	  so production got FS logging too, and clip_sd_busy() therefore returned
	  true from boot to ship mode: the whole SD idle power-off sequence
	  (unmount, disk deinit, SPI4 suspend, CS park, LDO2 off) never ran in any
	  build. Both intents fit if the backend is on for boot and then retires.

	  Debug builds default to 0 -- keeping UART logging means you want logs.
	  An explicit AT+LOG=info|debug cancels the retirement; the window only
	  ever withdraws the boot default, never a decision someone made.

	  Note the SD gate has two more conditions after this one: the device must
	  be in IDLE, and USB must have retired itself (10 minutes without VBUS,
	  see CLIP_USB_AT_AT_BOOT). Turning this window on does not by itself
	  make the rail drop.

