/* Device tree overlay for Clip2 application */

/ {
    /* Reserved for future use */
};

/* Enable display for UI module */
&ch1115 {
    status = "okay";
};

&i2c2 {
    status = "okay";
};

&uart0 {
    current-speed = <921600>;
};
