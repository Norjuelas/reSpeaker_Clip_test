/*
 * MCUboot device tree overlay
 *
 * Disable unnecessary devices for MCUboot to reduce boot power consumption.
 * Keep: SPI3 (external flash for DFU), I2C2 + CH1115 (OLED display), USB (serial recovery).
 */

/ {
	chosen {
		/* Keep external flash reference - needed for DFU */
		nordic,pm-ext-flash = &spi_flash;
		/* Boot mode retention for serial recovery trigger */
		zephyr,boot-mode = &boot_mode0;
		zephyr,uart-mcumgr = &cdc_acm_uart0;
	};
	aliases {
		mcuboot-button0 = &usr_btn;
	};
};

&uart0 {
	status = "disabled";
};

/* Boot mode retention register */
&gpregret1 {
	boot_mode0: boot_mode@0 {
		compatible = "zephyr,retention";
		status = "okay";
		reg = <0x0 0x1>;
	};
};

/* Enable USB for CDC serial recovery */
&usbd {
	status = "okay";
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/* I2C1 and NPM1300 for motor haptic */
&i2c1 {
	status = "okay";
	/delete-property/ zephyr,pm-device-runtime-auto;
};

&npm1300 {
	status = "okay";
};
&npm1300_regulators {
	status = "okay";
};
&npm1300_buck1 {
	status = "okay";
};
&npm1300_gpio {
	status = "disabled";
};
&npm1300_buck2 {
	status = "disabled";
};
&npm1300_ldo1 {
	status = "disabled";
};
&npm1300_ldo2 {
	status = "disabled";
};
&npm1300_charger {
	status = "disabled";
};

/* Keep I2C2 and CH1115 enabled for OLED display */

/* Keep SPI3 enabled - external flash for DFU */

/* Enable SPI4 + SDHC for SD card erase in recovery mode */
&spi4 {
	status = "okay";
	/delete-property/ zephyr,pm-device-runtime-auto;
};
&sdhc0 {
	status = "okay";
};

/* Enable LDO2 for SD card power */
&npm1300_ldo2 {
	status = "okay";
};

/* Disable QSPI WiFi */
&qspi {
	status = "disabled";
};
&nrf70 {
	status = "disabled";
};

/* Disable PDM microphone */
&pdm0 {
	status = "disabled";
};

/* Disable ADC */
&adc {
	status = "disabled";
};

/* Disable regulators not needed in bootloader */
&npm1300_ldo1 {
	status = "disabled";
};
&npm1300_ldo2 {
	status = "disabled";
};
&oled_reg {
	status = "okay";
};
&rfsw_reg {
	status = "disabled";
};
