/* SPDX-License-Identifier: Apache-2.0 */
/*
 * MCUboot device tree overlay
 *
 * This disables unnecessary devices for MCUboot to reduce size and avoid link errors.
 * Keep SPI3 (external flash) enabled for DFU operations.
 */

/ {
	chosen {
		/* Keep external flash reference - needed for DFU */
		nordic,pm-ext-flash = &spi_flash;
		/* Boot mode retention for serial recovery trigger */
		zephyr,boot-mode = &boot_mode0;
		/*
		 * Point uart-mcumgr to CDC ACM (not uart0), so the compiler check in
		 * serial_adapter.c passes: CDC ACM + UART console can coexist as long as
		 * zephyr,uart-mcumgr differs from zephyr,console.
		 */
		zephyr,uart-mcumgr = &cdc_acm_uart0;
	};
	aliases {
		/* Required by MCUboot serial recovery for GPIO pin detection */
		mcuboot-button0 = &usr_btn;
	};
};

&uart0 {
	status = "disabled";
};

/* Boot mode retention register - written by app to trigger USB DFU on reboot */
&gpregret1 {
	boot_mode0: boot_mode@0 {
		compatible = "zephyr,retention";
		status = "okay";
		reg = <0x0 0x1>;
	};
};

/* Enable USB for CDC serial recovery */
&usbd {
	status = "okay";
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/* Disable I2C1 and related devices (PMIC, sensors) */
&i2c1 {
	status = "disabled";
};

/* Disable PMIC device explicitly */
&npm1300 {
	status = "disabled";
};

/* Disable PMIC GPIO explicitly */
&npm1300_gpio {
	status = "disabled";
};

/* Disable PMIC regulators */
&npm1300_regulators {
	status = "disabled";
};

/* Keep I2C2 and CH1115 enabled for OLED display in MCUboot */
/* &i2c2 must stay enabled */
/* &ch1115 must stay enabled */

/* Keep SPI3 enabled - external flash for DFU */
/* &spi3 must stay enabled */

/* Disable SD card on SPI4 */
&spi4 {
	status = "disabled";
};

/* Disable QSPI WiFi */
&qspi {
	status = "disabled";
};

/* Disable PDM microphone */
&pdm0 {
	status = "disabled";
};

/* usbd is enabled above for CDC serial recovery */

/* Disable regulators */
&mic_reg {
	status = "disabled";
};

&oled_reg {
	status = "okay";
};

&rfsw_reg {
	status = "disabled";
};
